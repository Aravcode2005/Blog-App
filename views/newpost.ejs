<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%=pageTitle%></title>
  
</head>
<body>
    <div class="main-container">
    <form id="usercontent" method="POST" action="write">

     <p>
    <label for="userid">Enter the id:</label>
    <input type="text" id="inputtaext"  name="inputtaext" placeholder="Enter the id"/>
    </p>
    <p>
    <label for="username">Enter the title:</label>
    <input type="text" id="inputtext"  name="inputtext" placeholder="Enter the title"/>
    </p>
    <p>
    <label for="textarea">Enter the text</label>
    <textarea id="text-area" id="texxtarea" name="texxtarea" rows="4" cols="50" >Enter your comments here </textarea>
    </p>
    <input type="submit" value="Submit" >
    </form>
   </div>
</body>
</html>
